{
  "name": "@pann/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../board/dist',{recursive:true})\" && wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "collect:local": "curl -s \"http://127.0.0.1:8787/__scheduled?cron=7+*+*+*+*\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@pann/shared": "workspace:*",
    "@supabase/supabase-js": "^2.75.0",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.10.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  }
}
