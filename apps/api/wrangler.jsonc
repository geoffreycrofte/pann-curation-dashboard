{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pann",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The board (apps/board) is served as static assets by this same Worker.
  // Only /api/* reaches the Worker code; everything else is the SPA.
  "assets": {
    "directory": "../board/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  "vars": {
    "SUPABASE_URL": "http://127.0.0.1:54321",
  },
  // Secrets (wrangler secret put / .dev.vars): SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY,
  // EXA_API_KEY, GITHUB_TOKEN (optional)

  "observability": { "enabled": true },

  // Hourly; each run only collects the sources that are due (isSourceDue).
  // Keep in sync with COLLECT_CRON in src/jobs/scheduled.ts.
  "triggers": { "crons": ["7 * * * *"] },
}
